# Strategic OSIRIS (SIFP) Environment Configuration
# Copy this file to .env and fill in your values

# ── AI Gateway (OpenRouter) ──
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Set to 1 to force mock/offline analytical generator without using API credits
MOCK_LLM=0

# Default model overrides (leave empty to use per-agent defaults)
OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-5.5
CHIEF_MODEL=anthropic/claude-haiku-5.5
SPECIALIST_MODEL=anthropic/claude-haiku-5.5
RED_TEAM_MODEL=anthropic/claude-haiku-5.5

# ── Host and Domain ──
SITE_URL=https://osiris.yourdomain.com
APP_NAME=Strategic OSIRIS Intelligence Platform
PORT=8000
HOST=0.0.0.0

# ── Upstream OSIRIS Platform (Direct Integration) ──
OSIRIS_URL=https://agent.gorbit.space

# ── MiroFish Wargaming & Swarm Simulation Engine ──
MIROFISH_URL=http://localhost:5001
ZEP_API_KEY=

# ── Database & Cache ──
POSTGRES_USER=osiris
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=strategic_osiris
DATABASE_URL=postgresql://osiris:your_secure_password_here@localhost:5432/strategic_osiris
REDIS_URL=redis://localhost:6379/0

# ── Focus Countries ──
DEFAULT_REFERENCE_COUNTRY=Egypt
DEFAULT_TARGET_COUNTRIES=Egypt,Libya,Israel
